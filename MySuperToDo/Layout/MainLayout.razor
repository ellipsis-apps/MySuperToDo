@using MySuperToDo.Services
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<RadzenLayout Style="min-height: 100vh;">
	<RadzenHeader>
		<div style="display: flex; align-items: center; width: 100%;">
			<!-- Sidebar toggler: accessible inline SVG icon with Blazor click handler -->
			<button class="rz-sidebar-toggle navbar-toggler-plain" type="button"
				@onclick="ToggleSidebar" @onclick:stopPropagation @onclick:preventDefault
				aria-label="Toggle sidebar" aria-expanded="@sidebarExpanded">
				<svg width="24" height="24" viewBox="0 0 24 24" role="img" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
					<rect x="3" y="6" width="18" height="2" rx="1"></rect>
					<rect x="3" y="11" width="18" height="2" rx="1"></rect>
					<rect x="3" y="16" width="18" height="2" rx="1"></rect>
				</svg>
			</button>
			<!-- Sidebar toggler: call Blazor code to toggle the Radzen sidebar (avoid Bootstrap JS) -->
			<button class="navbar-toggler ms-2" type="button"
				@onclick="ToggleSidebar" @onclick:stopPropagation @onclick:preventDefault
				aria-controls="navMenu" aria-expanded="@sidebarExpanded" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<span style="flex: 1;"></span>
			  <span class="gun-status @( _hasGunPeers ? "gun-status--online" : "gun-status--offline" )">
				<span class="gun-status__dot" title="@_gunPeersTooltip" aria-label="@_gunPeersTooltip" tabindex="0"></span>
				<span class="gun-status__text">@( _hasGunPeers ? "GunDB online" : "GunDB local only" )</span>
			</span>
			<RadzenLink Path="https://learn.microsoft.com/aspnet/core/" Target="_blank" Text="About" Style="margin-right: 1rem;" />
			<RadzenSplitButton AlwaysOpenPopup="true"
							   ButtonStyle="ButtonStyle.Light"
							   Variant="Variant.Text"
							   Click="@OnProfileMenuItemClick">
				<ButtonContent>
					<span class="user-avatar">
						<RadzenIcon Icon="person" />
					</span>
                  <span class="profile-label">@_userDisplayName</span>
				</ButtonContent>
				<ChildContent>
                  <RadzenSplitButtonItem Text="@_authStatusLabel" Disabled="true" />
                  @if (_isAuthenticated)
					{
						<RadzenSplitButtonItem Text="Settings" Value="settings" Icon="settings" />
						<RadzenSplitButtonItem Text="Logout" Value="logout" Icon="logout" />
					}
					else
					{
						<RadzenSplitButtonItem Text="Sign In" Value="signin" Icon="login" />
					}
				</ChildContent>
			</RadzenSplitButton>
		</div>
	</RadzenHeader>

	<RadzenSidebar @bind-Expanded="sidebarExpanded">
		<NavMenu />
	</RadzenSidebar>

	<RadzenBody>
		<div class="p-4">
			@Body
		</div>
	</RadzenBody>
</RadzenLayout>
<RadzenDialog />
<RadzenContextMenu />
